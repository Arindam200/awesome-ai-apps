# Nebius Token Factory (https://tokenfactory.nebius.com). Any OpenAI-compatible endpoint
# with tool calling also works: set NEBIUS_BASE_URL and NEBIUS_MODEL to its values.
NEBIUS_API_KEY=your_nebius_token_factory_api_key
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Loom. The defaults are a single-user Loom on this machine, which needs no token.
LOOM_BASE_URL=http://localhost:7777
LOOM_ORG=dev
LOOM_NAMESPACE=local
# A team server needs a token from its dashboard (Settings, then Tokens).
LOOM_API_KEY=
