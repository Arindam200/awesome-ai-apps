# MiniMax API key (used via the OpenAI-compatible SDK).
OPENAI_API_KEY=Your Minimax api key here

# MiniMax OpenAI-compatible base URL.
# global_en region: https://api.minimax.io/v1
# cn_zh region:     https://api.minimaxi.com/v1
OPENAI_BASE_URL=https://api.minimax.io/v1

# Optional: override the chat model (defaults to MiniMax-M3).
# YOUTUBE_TREND_MODEL=MiniMax-M3
# Optional: override the ingestion model (defaults to MiniMax-M3).
# YOUTUBE_TREND_INGEST_MODEL=MiniMax-M3

EXA_API_KEY=Your exaAI api key here
MEMORI_API_KEY=Your Memori API key here
