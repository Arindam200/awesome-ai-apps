# Copy this file to .env and fill in your key
# Note: the demo's memory operations (write/correct/as_of/court) run entirely
# locally against MemTether's SQLite DB. The LLM is optional and only used
# if you want to generate the fact text via chat completion.
NEBIUS_API_KEY="your_nebius_api_key_here"
# Optional: override the LLM model or use any OpenAI-compatible endpoint
# LLM_MODEL="deepseek-ai/DeepSeek-V3-0324"
# OPENAI_BASE_URL="https://api.tokenfactory.nebius.com/v1"
