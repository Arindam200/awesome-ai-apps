# Copy this file to .env and fill in your key.
# NEBIUS_API_KEY is required: main.py uses the model to extract facts, to decide
# which stored fact a correction supersedes, and to answer from as_of snapshots.
NEBIUS_API_KEY="your_nebius_api_key_here"

# Optional: override the model, or point at another OpenAI-compatible endpoint.
# LLM_MODEL="Qwen/Qwen3-235B-A22B-Instruct-2507"
# OPENAI_BASE_URL="https://api.tokenfactory.nebius.com/v1"