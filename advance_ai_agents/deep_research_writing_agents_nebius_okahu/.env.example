# Mandatory
NEBIUS_API_KEY=...
EXA_API_KEY=...

# Configure the key for the selected image provider.
GEMINI_API_KEY=...
MINIMAX_API_KEY=...

# Optional provider/model overrides
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
WRITER_MODEL=meta-llama/Llama-3.3-70B-Instruct
REVIEWER_MODEL=meta-llama/Llama-3.3-70B-Instruct
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_PROVIDER=gemini
MINIMAX_API_REGION=global_en
MINIMAX_IMAGE_MODEL=image-01
# Optional endpoint override; otherwise the region selects the endpoint.
# MINIMAX_IMAGE_ENDPOINT=https://api.minimax.io/v1/image_generation

# Optional Okahu / Monocle tracing
OKAHU_API_KEY=...
MONOCLE_EXPORTER=file,okahu
OKAHU_WORKFLOW_RESEARCH=research-agent
OKAHU_WORKFLOW_WRITING=writing-workflow
