# Nebius Token Factory API key: https://tokenfactory.nebius.com/
NEBIUS_API_KEY="your_nebius_token_factory_api_key"

# Optional: a different Token Factory model, and how hard it thinks per call.
# NEBIUS_MODEL="moonshotai/Kimi-K3.1-Pro"
# REASONING_EFFORT="medium"

# Optional: also post the agent's notifications to Slack (incoming webhook URL).
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
