# Jev Decisions API credential. Never pass this key to the socai subprocess.
OPENROUTER_API_KEY=your_openrouter_api_key

# Nebius Token Factory credential for evidence-grounded synthesis.
NEBIUS_API_KEY=your_nebius_token_factory_api_key

# Optional overrides.
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B
SOCAI_BIN=socai
