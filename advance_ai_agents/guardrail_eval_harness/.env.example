# Required only for optional live evaluation (--mode live).
# Offline runs need no credentials and make no network calls.
NEBIUS_API_KEY="your_nebius_api_key"
# Optional: override the Nebius OpenAI-compatible endpoint.
EXAMPLE_BASE_URL="https://api.tokenfactory.nebius.com/v1"
# Optional: default live model override (a tool-capable model is still required
# explicitly via --live-model on each live run).
EXAMPLE_MODEL_NAME="meta-llama/Llama-3.3-70B-Instruct"
