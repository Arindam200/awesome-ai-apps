# Required only for optional live evaluation (--mode live).
# Offline runs need no credentials and make no network calls.
NEBIUS_API_KEY="your_nebius_api_key"
# Default live model, used when --live-model is not passed on the CLI.
# Must be a tool-calling model. List current IDs with:
#   curl -s "$EXAMPLE_BASE_URL/models" -H "Authorization: Bearer $NEBIUS_API_KEY"
EXAMPLE_MODEL_NAME="Qwen/Qwen3-30B-A3B-Instruct-2507"
# Optional: override the Nebius Token Factory endpoint.
EXAMPLE_BASE_URL="https://api.tokenfactory.nebius.com/v1"
