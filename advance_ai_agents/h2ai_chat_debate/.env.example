# One key per provider. You only need the ones your agents.json actually uses.

# Nebius Token Factory - https://dub.sh/nebius
NEBIUS_API_KEY="your_nebius_api_key"

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_api_key"

# Local models (Ollama, LM Studio). These servers ignore the key, but the
# OpenAI client refuses to start without one, so any non-empty string works.
LOCAL_API_KEY="not-needed"
