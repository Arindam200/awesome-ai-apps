# Memory service. Free key at https://console.mnemoverse.com
MNEMOVERSE_API_KEY=your_mnemoverse_api_key_here

# Model provider, used only for the answering step.
# The protocol walkthrough runs without it. https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional. Namespace the demo writes into. Change it to start the story
# from scratch on a key that has already run this example.
MNEMOVERSE_DEMO_DOMAIN=project:release-assistant-mcp
