# Raah Analytics API token
# Get this from: raah.dev → Settings → API → Generate token
RAAH_API_TOKEN=your_raah_api_token_here

# Cloudflare Workers AI credentials
# Account ID: dash.cloudflare.com → right sidebar
# API Token:  dash.cloudflare.com → My Profile → API Tokens → Create Token (Workers AI template)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Optional: default Raah project ID (leave blank to auto-discover)
RAAH_PROJECT_ID=
