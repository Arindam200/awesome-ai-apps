# OpenAI-compatible API configuration

# Default: local Ollama
# The model must already be available in your server. For Ollama, pull the
# default first (`ollama pull qwen3:8b`) or set LLM_MODEL to a model you have.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3:8b

# Replace these values with the endpoint, API key, and model identifier
# provided by your chosen OpenAI-compatible service. Local servers that do
# not require authentication can use a placeholder such as "not-needed".
