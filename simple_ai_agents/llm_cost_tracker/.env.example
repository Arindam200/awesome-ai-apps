# Live mode only; demo mode makes no network requests.
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_PROVIDER=nebius
LLM_MODEL=
LLM_COST_DB=.data/usage.sqlite3
# Copy pricing.example.json to pricing.json and replace the synthetic demo entries
# with your provider's current model rates before making a live request.
# Relative paths are based on this example's directory, regardless of the working directory.
LLM_PRICING_FILE=pricing.json
