# Nebius Token Factory key for the optional model brief. Not needed with --no-synthesis.
NEBIUS_API_KEY=your_nebius_token_factory_api_key

# Optional. USD works without it; other currencies, full history and real-time releases need one.
FXMACRODATA_API_KEY=

# Optional model override.
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B
